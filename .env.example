# Partiri Cloud MCP Server — example environment configuration.
# Copy to `.env` and adjust. Every value is optional unless noted otherwise.
# The server reads process.env directly; load this file with your process
# manager or a tool such as dotenv.

# ── Partiri API ───────────────────────────────────────────────────────────────
# API key for the Partiri REST API. REQUIRED for the stdio transport unless a
# key is resolvable from ~/.config/partiri/key or an interactive browser login.
PARTIRI_API_KEY=
# Partiri API base URL (must be HTTPS).
PARTIRI_API_URL=https://api.partiri.cloud
# Hosted Partiri web app URL — used by the HTTP transport's OAuth sign-in redirect.
PARTIRI_WEB_URL=https://partiri.cloud
# API request timeout, in seconds.
PARTIRI_TIMEOUT=30

# ── Transport ─────────────────────────────────────────────────────────────────
# Transport mode: "stdio" (default) or "http".
MCP_TRANSPORT=stdio
# HTTP server port (http transport only).
PORT=3000

# ── HTTP transport / OAuth 2.1 (only when MCP_TRANSPORT=http) ──────────────────
# 32-byte hex key (64 chars) for stateless token encryption. REQUIRED in
# production. Generate with: openssl rand -hex 32
# If unset, a key is auto-generated (dev) or read from <MCP_DATA_DIR>/token-secret.
MCP_TOKEN_SECRET=
# Public URL of this MCP server (used to build OAuth callback URLs).
MCP_BASE_URL=https://your-domain.example
# Persistent directory for state that must survive restarts: dynamic client
# registrations (clients.json) and the token-secret fallback file. Strongly
# recommended in production so users don't re-authenticate after every redeploy.
# Single-replica only (file-backed, not shared across pods).
MCP_DATA_DIR=/app/data
# Comma-separated hosts allowed as OAuth redirect targets, IN ADDITION to
# loopback (which is always allowed). Set to the host(s) of any non-loopback MCP
# clients you trust (e.g. a hosted web client). Empty = loopback redirects only.
MCP_ALLOWED_REDIRECT_HOSTS=
# Trusted reverse-proxy IP(s)/CIDR(s) in front of this server, e.g. your ingress
# range "10.0.0.0/8" (or a bare trusted-hop count). REQUIRED in production so the
# real client IP is taken from X-Forwarded-For only for requests that came through
# the proxy and cannot be spoofed. Unset = trust only a loopback proxy (whose
# X-Forwarded-For IS trusted, so a same-host proxy must strip inbound XFF).
MCP_TRUSTED_PROXIES=

# ── Sessions (http transport) ─────────────────────────────────────────────────
# Max concurrent MCP sessions.
MCP_MAX_SESSIONS=1000
# Max concurrent sessions per API key.
MCP_MAX_SESSIONS_PER_KEY=5
# Session inactivity timeout, in minutes.
MCP_SESSION_TTL_MINUTES=30

# ── Tool exposure ─────────────────────────────────────────────────────────────
# When truthy (1/true/yes/on), only read-only tools are registered — a low-trust
# surface for read-only agent sessions.
MCP_READONLY=false
# Comma-separated tool names to enable on top of the base set (e.g. to add a
# specific write tool back when MCP_READONLY is on). Optional.
MCP_TOOLS_ALLOWLIST=
# Comma-separated tool names to remove. Always wins over the allowlist. Optional.
MCP_TOOLS_DENYLIST=
